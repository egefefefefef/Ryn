# Structs are value types: passing them to a function copies them, and
# returning them copies them back.
struct Vector2:
    x: f32
    y: f32

fn add(a: Vector2, b: Vector2) -> Vector2:
    return Vector2 { x: a.x + b.x, y: a.y + b.y }

fn dot(a: Vector2, b: Vector2) -> f32:
    return a.x * b.x + a.y * b.y

fn main() -> i32:
    let a = Vector2 { x: 1.0, y: 2.0 }
    let b = Vector2 { x: 3.0, y: 4.0 }
    let sum = add(a, b)
    println(sum.x)
    println(sum.y)
    println(dot(a, b))
    return 0
