import mem

fn main() -> i32:
    let n: i64 = 20000000
    let raw = mem.alloc(n as u64)
    var flags = raw as ptr<u8>
    var i: i64 = 0
    while i < n:
        flags[i] = 1
        i = i + 1
    flags[0] = 0
    flags[1] = 0
    var p: i64 = 2
    while p * p < n:
        if flags[p] == 1:
            var m: i64 = p * p
            while m < n:
                flags[m] = 0
                m = m + p
        p = p + 1
    var count: i64 = 0
    i = 0
    while i < n:
        if flags[i] == 1:
            count = count + 1
        i = i + 1
    println(count)
    mem.free(raw)
    return 0
